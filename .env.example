# Preferred production path: Cloud Run service identity + Vertex AI
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# Optional server-side fallback for Gemini Developer API.
# Never expose this value to frontend code.
GEMINI_API_KEY=

# ARI owner-session boundary. Store real values in Secret Manager / Cloud Run secrets.
ARI_REQUIRE_AUTH=true
ARI_SESSION_SECRET=
OWNER_ACCESS_CODE=
ARI_SESSION_TTL_SECONDS=43200
